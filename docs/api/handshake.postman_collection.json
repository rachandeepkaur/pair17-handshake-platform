{
  "info": {
    "name": "Handshake Platform API (Pair 17)",
    "description": "REST API for the student/company recruiting platform. Authorize with the `access_token` from `POST /auth/login` as a Bearer token.\n\nRun **auth > Login** first; its test script stores `access_token` in the `token` collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9170"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "assistant",
      "item": [
        {
          "name": "Send a message to the assistant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/assistant/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assistant",
                "chat"
              ]
            },
            "description": "Send a message to the assistant",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"string\",\n  \"conversation\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"\",\n      \"tool_name\": \"string\",\n      \"tool_calls\": [\n        {\n          \"name\": \"string\",\n          \"arguments\": {},\n          \"index\": 1\n        }\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Approve or decline the action the assistant is waiting on",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/assistant/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assistant",
                "confirm"
              ]
            },
            "description": "Approve or decline the action the assistant is waiting on",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversation\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"\",\n      \"tool_name\": \"string\",\n      \"tool_calls\": [\n        {\n          \"name\": \"string\",\n          \"arguments\": {},\n          \"index\": 1\n        }\n      ]\n    }\n  ],\n  \"approved\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "auth",
      "item": [
        {
          "name": "Signup Company",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/signup/company",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup",
                "company"
              ]
            },
            "description": "Signup Company",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company_name\": \"string\",\n  \"email\": \"user@example.com\",\n  \"password\": \"string\",\n  \"location\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"string\",\n  \"password\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.access_token) { pm.collectionVariables.set('token', body.access_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Change the signed-in account's password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/change-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "change-password"
              ]
            },
            "description": "Change the signed-in account's password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"string\",\n  \"new_password\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
